# Copy this file to .env and fill in real values. Never commit .env.

# Django
# LOCAL development: DJANGO_DEBUG=True. HOSTED server: leave it False (the default) and set a
# real, long random DJANGO_SECRET_KEY, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
# Hosted: the API's own domain, e.g. myapp.onrender.com (comma-separated, no https://)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Websites allowed to call this API from a browser (scheme + host only, no path).
# Defaults to the GitHub Pages site, so usually you do not need to set it.
# CORS_ALLOWED_ORIGINS=https://renumittal.github.io
# Hosted only, for the /admin/ login: https://myapp.onrender.com
# CSRF_TRUSTED_ORIGINS=https://myapp.onrender.com

# Supabase Postgres connection string.
# Use the POOLED (transaction mode, port 6543) connection string for normal app runtime.
# Example pooled: postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Use the DIRECT connection string (port 5432, db.<project-ref>.supabase.co) when running
# `manage.py migrate` / `makemigrations` against Supabase, since the transaction pooler
# does not support the session-level features Django's migration DDL sometimes needs.
# Example direct: postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DIRECT_DATABASE_URL=postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Supplier bills (private Supabase Storage). Server-side only: never put the service-role key
# in the web app. Leave unset locally to disable the bill endpoints (they answer 503).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service_role key from Supabase > Project Settings > API>
# SUPABASE_BILLS_BUCKET=supplier-bills
