# Copy this file to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Supabase Postgres connection string.
# Use the POOLED (transaction mode, port 6543) connection string for normal app runtime.
# Example pooled: postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Use the DIRECT connection string (port 5432, db.<project-ref>.supabase.co) when running
# `manage.py migrate` / `makemigrations` against Supabase, since the transaction pooler
# does not support the session-level features Django's migration DDL sometimes needs.
# Example direct: postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DIRECT_DATABASE_URL=postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
